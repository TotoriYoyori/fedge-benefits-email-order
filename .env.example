# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env — see README's security notes.

# --------------- Core app / database ---------------
DATABASE_URL=sqlite+aiosqlite:///./local.sqlite3
DB_ECHO=true
ENVIRONMENT=local
ALLOW_ORIGINS=*

# --------------- Auth (JWT) ---------------
# Generate your own, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-never-committed
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional: {"some-dev-key": "admin"} to self-assign a role at registration time.
DEV_ROLE_KEYS={}

# --------------- Google OAuth2 / Gmail ---------------
# Create your own OAuth client in Google Cloud Console. For a public demo,
# request only basic identity scopes (openid,email,profile) — Gmail scopes
# require Google's app-verification review. See README for why.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/google/callback
GOOGLE_SCOPES=openid,email,https://www.googleapis.com/auth/gmail.readonly

# --------------- Notification / Email provider ---------------
# resend = production sending; mailtrap = sandbox testing (recommended for local/demo use)
EMAIL_PROVIDER=mailtrap
EMAIL_FROM_NAME=Reminder Bot
EMAIL_FROM_ADDRESS=reminders@fedge-demo-studio.com

# Required if EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Required if EMAIL_PROVIDER=mailtrap — create a free sandbox inbox at mailtrap.io.
# The values below are placeholders that satisfy validation so the app/tests can boot
# locally without a real Mailtrap account (no email actually gets sent). Replace both
# with your real sandbox inbox's API key and numeric inbox ID to actually send emails.
MAILTRAP_API_KEY=dev-placeholder-key
MAILTRAP_SANDBOX_INBOX_ID=123456
